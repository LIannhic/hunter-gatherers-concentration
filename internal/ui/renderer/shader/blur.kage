package main

var Intensity float

func Fragment(position vec4, texCoord vec2, color vec4) vec4 {
    clr := vec4(0, 0, 0, 0)
    samples := 9
    // Offset en pixels pour le flou
    offset := 2.5 * Intensity

    clr += imageSrc0At(texCoord + vec2(-offset, -offset))
    clr += imageSrc0At(texCoord + vec2(0, -offset))
    clr += imageSrc0At(texCoord + vec2(offset, -offset))
    clr += imageSrc0At(texCoord + vec2(-offset, 0))
    clr += imageSrc0At(texCoord)
    clr += imageSrc0At(texCoord + vec2(offset, 0))
    clr += imageSrc0At(texCoord + vec2(-offset, offset))
    clr += imageSrc0At(texCoord + vec2(0, offset))
    clr += imageSrc0At(texCoord + vec2(offset, offset))

    return clr / float(samples)
}