//kage:unit pixels

package main

var Time float
var Center vec2
var Intensity float
var Resolution vec2

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	center := Center * Resolution
	pos := dstPos.xy - center
	dist := length(pos)

	radius := 250.0
	eyeRadius := 35.0

	if dist > radius {
		return imageSrc0At(srcPos)
	}

	// 1. Transition ultra-douce (Feathering) aux bordures du vortex
	edgeDecline := smoothstep(radius, radius-50.0, dist)
	eyeIncline := smoothstep(eyeRadius, eyeRadius+15.0, dist)
	mask := edgeDecline * eyeIncline

	if mask <= 0.0 {
		return imageSrc0At(srcPos)
	}

	// 2. Progression du centre (1.0) vers l'extérieur (0.0)
	percent := (radius - dist) / (radius - eyeRadius)

	// 3. Distorsion asymétrique (effet fluide/vague)
	angle := atan2(pos.y, pos.x)
	distortion := sin(angle*3.0+Time*2.5) * 0.12 * (1.0 - percent)

	// 4. Calcul de la rotation (Torsion spirale + vitesse continue)
	swirl := percent * percent * 4.5 * Intensity
	spin := Time*2.0 + distortion
	theta := swirl + spin

	s := sin(theta)
	c := cos(theta)

	// Application de la matrice de rotation
	rotatedPos := vec2(
		pos.x*c-pos.y*s,
		pos.x*s+pos.y*c,
	)

	// 5. Effet d'aspiration gravitationnelle vers le centre (Sink)
	pull := 1.0 - (percent * 0.20 * Intensity)
	rotatedPos *= pull

	// Mix fluide entre la texture d'origine et la déformation
	finalPos := mix(pos, rotatedPos, mask)

	// Vérification des bornes avant échantillonnage
	samplePos := finalPos + center
	if samplePos.x < 0.0 || samplePos.x > Resolution.x || samplePos.y < 0.0 || samplePos.y > Resolution.y {
		return imageSrc0At(srcPos)
	}

	return imageSrc0At(samplePos)
}
