//kage:unit pixels

package main

var Center vec2     // Normalized [0,1]
var Intensity float32
var Resolution vec2 // Size in pixels

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	center := Center * Resolution

	pos := dstPos.xy - center
	dist := length(pos)

	// Rayon d'action du vortex en pixels (environ 2.5 cases)
	radius := 180.0

	if dist < radius {
		// Calcul de l'angle de rotation basé sur la distance
		// Plus on est proche du centre, plus la rotation est forte (spirale)
		percent := (radius - dist) / radius
		theta := percent * percent * 8.0 * Intensity

		// Matrice de rotation inverse pour transformer la lecture du pixel
		s := sin(theta)
		c := cos(theta)

		// Coordonnées de lecture relatives au centre
		rotatedPos := vec2(
			pos.x * c - pos.y * s,
			pos.x * s + pos.y * c
		)

		return imageSrc0At(rotatedPos + center)
	}

	return imageSrc0At(dstPos.xy)
}
