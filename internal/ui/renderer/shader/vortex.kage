//kage:unit pixels

package main

var Time float
var Center vec2
var Intensity float
var Resolution vec2

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	center := Center * Resolution

	pos := srcPos - center
	dist := length(pos)

	// Rayon plus étendu (environ 4 cases)
	radius := 350.0

	// Rayon de l'oeil du cyclone (la tuile portail reste visible)
	eyeRadius := 45.0

	if dist < radius && dist > eyeRadius {
		// Normalisation entre eyeRadius et radius
		percent := (radius - dist) / (radius - eyeRadius)

		// Torsion plus légère et progressive (sinusoïdale pour la douceur)
		// On réduit la force de torsion de 12.0 à 4.0
		swirl := percent * percent * 4.0 * Intensity

		// Rotation continue dans le temps
		spin := Time * 1.5

		theta := swirl + spin

		s := sin(theta)
		c := cos(theta)

		rotatedPos := vec2(
			pos.x*c - pos.y*s,
			pos.x*s + pos.y*c,
		)

		return imageSrc0At(rotatedPos + center)
	}

	return imageSrc0At(srcPos)
}
