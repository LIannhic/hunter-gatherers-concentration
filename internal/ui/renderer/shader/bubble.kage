package main

var Center vec2
var Intensity float
var Resolution vec2

func Fragment(position vec4, texCoord vec2, color vec4) vec4 {
    // Calcul du ratio d'aspect dynamique
    aspect := Resolution.x / Resolution.y

    // Passage dans un espace carré (isotrope) pour les calculs de distance
    uv := vec2(texCoord.x * aspect, texCoord.y)
    center := vec2(Center.x * aspect, Center.y)

    delta := uv - center
    dist := length(delta)

    // Rayon normalisé par rapport à la hauteur
    radius := 0.09 * Intensity

    if dist < radius {
        // Calcul de la distortion dans l'espace isotrope
        strength := 1.0 - sqrt(1.0 - pow(dist / radius, 2.0))

        // Déformation de la coordonnée de lecture
        warped := uv - delta * strength

        // Retour vers l'espace UV normalisé (rectangulaire)
        warped.x /= aspect

        return imageSrc0At(warped)
    }

    return imageSrc0At(texCoord)
}