package main

var Center vec2
var Intensity float

func Fragment(position vec4, texCoord vec2, color vec4) vec4 {
    p := texCoord - Center
    r := length(p)

    // Rayon fixe en pixels pour englober une tuile (88px)
    // On multiplie par Intensity pour que la bulle apparaisse progressivement
    bubbleRadius := 70.0 * Intensity

    if r < bubbleRadius {
        // Distortion de loupe concentrée
        dist := r / bubbleRadius

        // Formule de zoom : mix entre identité et grossissement
        // factor < 1.0 = zoom in
        factor := 1.0 - (1.0 - pow(dist, 2.0)) * 0.5

        return imageSrc0At(Center + p * factor)
    }

    return imageSrc0At(texCoord)
}