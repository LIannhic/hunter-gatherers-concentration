package main

var Center vec2
var Intensity float

func Fragment(position vec4, texCoord vec2, color vec4) vec4 {
    // Ratio d'aspect pour transformer les coordonnées rectangulaires en espace carré
    aspectRatio := 1280.0 / 720.0

    p := texCoord - Center
    p.x *= aspectRatio

    r := length(p)

    // Rayon ciblé pour englober une tuile (88px)
    // 60px / 720px ~ 0.083. On arrondit à 0.09 pour un effet généreux.
    bubbleRadius := 0.09 * Intensity

    if r < bubbleRadius {
        // Distortion de lentille sphérique
        factor := 1.0 - sqrt(1.0 - pow(r / bubbleRadius, 2.0))

        offset := p * factor
        offset.x /= aspectRatio

        return imageSrc0At(Center + offset)
    }

    return imageSrc0At(texCoord)
}