package main

var Time float
var Intensity float
var Resolution vec2

func Fragment(position vec4, texCoord vec2, color vec4) vec4 {
    freq := 20.0
    amp := 0.005
    offset := vec2(sin(texCoord.y * freq + Time * 5.0) * amp, 0.0)

    original := imageSrc0At(texCoord)
    processed := imageSrc0At(texCoord + offset)

    return mix(original, processed, Intensity)
}