//kage:unit pixels

package main

var Time float
var Intensity float
var Center vec2 // Centre de l'effet en PIXELS logiques

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
    // 1. Taille de l'image source en pixels
    res := imageSrc0Size()

    // 2. Calcul du vecteur relatif au centre en PIXELS logiques
    // On utilise srcPos pour être cohérent avec le sampling imageSrc0At
    relPos := srcPos - Center

    // 3. Distance normalisée par rapport à la taille de l'image
    // On conserve la logique de distension elliptique originale
    relUV := relPos / res
    distFromCenter := length(relUV)

    // 4. Formule de distorsion originale
    // Calcul de distorsion standard (0.4 pour l'effet de bombement)
    distortion := 1.0 + distFromCenter*distFromCenter*0.4*Intensity

    // Le Pulse basé sur le temps
    pulse := sin(Time*(2.0+5.0*Intensity)) * 0.03 * Intensity
    distortion += pulse

    // L'aberration chromatique (décalage R/B)
    chromaShift := 0.02 * Intensity * distFromCenter

    // 5. Calcul des décalages (offsets) en PIXELS
    // On applique la distorsion par rapport au vecteur relatif
    offsetR := relPos * (distortion + chromaShift - 1.0)
    offsetG := relPos * (distortion - 1.0)
    offsetB := relPos * (distortion - chromaShift - 1.0)

    // 6. Échantillonnage final
    // Utilisation de srcPos (pixels source) + décalage calculé
    return vec4(
       imageSrc0At(srcPos + offsetR).r,
       imageSrc0At(srcPos + offsetG).g,
       imageSrc0At(srcPos + offsetB).b,
       1.0,
    )
}
