//kage:unit pixels

package main

var Time float
var Intensity float
var Resolution vec2

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	centerInPixels := Resolution * 0.5
	toCenter := dstPos.xy - centerInPixels

	// Utilisation de coordonnées normalisées pour le calcul de la distorsion
	// afin que l'effet soit cohérent quelle que soit la résolution.
	uvToCenter := toCenter / Resolution
	distFromCenter := length(uvToCenter)

	distortion := 1.0 + distFromCenter*distFromCenter*0.4*Intensity

	pulse := sin(Time*(2.0+5.0*Intensity)) * 0.03 * Intensity
	distortion += pulse

	// Aberration chromatique (calculée en normalized space puis appliquée en pixels)
	chromaShift := 0.02 * Intensity * distFromCenter

	// Calcul des offsets en pixels pour chaque canal
	offsetR := toCenter * (distortion + chromaShift - 1.0)
	offsetG := toCenter * (distortion - 1.0)
	offsetB := toCenter * (distortion - chromaShift - 1.0)

	baseColor := vec4(
		imageSrc0At(srcPos + offsetR).r,
		imageSrc0At(srcPos + offsetG).g,
		imageSrc0At(srcPos + offsetB).b,
		1.0,
	)

	return baseColor
}
