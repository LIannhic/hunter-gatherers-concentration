//kage:unit pixels
package main

var Time float
var Resolution vec2

func Fragment(dstPos vec4, srcPos vec2, srcColor vec4) vec4 {
	uv := dstPos.xy / Resolution.xy

	// Moss green palette
	mossColor := vec4(0.1, 0.3, 0.05, 0.8)
	mossHighlight := vec4(0.3, 0.5, 0.1, 0.9)

	// Column logic
	float cols = 25.0;
	float colIndex = floor(uv.x * cols);

	// Randomized speed and offset per column
	float seed = colIndex * 123.456;
	float speed = (fract(sin(seed) * 43758.5453) * 0.5 + 0.2);
	float offset = fract(cos(seed * 0.7) * 918.273) * 10.0;

	// Animation of the "drip head"
	float dripHead = fract(Time * speed * 0.2 + offset);

	// Create a "trail" behind the head
	float dripBody = smoothstep(dripHead - 0.4, dripHead, uv.y) * (1.0 - step(dripHead, uv.y));

	// Multiple drips per column for density
	float dripHead2 = fract(Time * speed * 0.3 + offset * 1.5 + 0.5);
	float dripBody2 = smoothstep(dripHead2 - 0.3, dripHead2, uv.y) * (1.0 - step(dripHead2, uv.y));

	float combinedDrip = max(dripBody, dripBody2);

	// Add some horizontal jitter/width variation
	float widthMask = smoothstep(0.0, 0.2, fract(uv.x * cols)) * (1.0 - smoothstep(0.8, 1.0, fract(uv.x * cols)));
	combinedDrip *= widthMask;

	// Final color calculation
	vec4 finalColor = mix(mossColor, mossHighlight, combinedDrip);

	// Overall alpha based on drip presence
	finalColor.a = combinedDrip * 0.85;

	// Add noise for organic texture
	float noise = fract(sin(dot(uv.xy + Time * 0.01, vec2(12.9898, 78.233))) * 43758.5453);
	finalColor.rgb *= (0.85 + 0.15 * noise);

	return finalColor
}
